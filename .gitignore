# ==========================================
# FERROSTATS — Production .gitignore
# ==========================================

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Local Databases (WAL files & ephemeral SQLite DBs)
data/db/*.db
data/db/*.db-wal
data/db/*.db-shm
data/db/*.sqlite
/tmp/ferrostats.db
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Security & Secrets Prevention (Zero Credential Leak Guarantee)
.env
.env.*
*.env
*.pem
*.key
*.pfx
*.p12
*.crt
*credentials*.json
*service_account*.json
*service-account*.json
client_secret*.json
token.json
gcp-key*.json
*.gcp-key.json

# Node & Dataform Compilation Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE, OS & Editor Caches
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs & Temporary Files
*.log
*.tmp
*.bak
scratch/
docs/.folio/

# Antigravity & Local Agent Directives
.agents/
